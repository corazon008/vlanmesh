# Exemple de configuration LXC Proxmox (/etc/pve/lxc/<id>.conf)
#
# - eth0 : management (une seule passerelle par défaut)
# - eth1..ethN : une patte par VLAN
# - les IP data peuvent être en DHCP : vlanmesh relit l'IP à chaque sweep
# - nesting + keyctl pour Docker
#
# Adapter les VLAN IDs et les hwaddr.

features: nesting=1,keyctl=1

net0: name=eth0,bridge=vmbr0,tag=99,ip=192.168.99.5/24,gw=192.168.99.254,hwaddr=AA:BB:CC:00:00:01
net1: name=eth1,bridge=vmbr0,tag=10,ip=dhcp,hwaddr=AA:BB:CC:00:00:02
net2: name=eth2,bridge=vmbr0,tag=20,ip=dhcp,hwaddr=AA:BB:CC:00:00:03
net3: name=eth3,bridge=vmbr0,tag=30,ip=dhcp,hwaddr=AA:BB:CC:00:00:04
net4: name=eth4,bridge=vmbr0,tag=40,ip=dhcp,hwaddr=AA:BB:CC:00:00:05
net5: name=eth5,bridge=vmbr0,tag=50,ip=dhcp,hwaddr=AA:BB:CC:00:00:06
net6: name=eth6,bridge=vmbr0,tag=60,ip=dhcp,hwaddr=AA:BB:CC:00:00:07
net7: name=eth7,bridge=vmbr0,tag=70,ip=dhcp,hwaddr=AA:BB:CC:00:00:08
net8: name=eth8,bridge=vmbr0,tag=80,ip=dhcp,hwaddr=AA:BB:CC:00:00:09
